{
  "name": "zimba",
  "displayName": "Zimba",
  "description": "Code-first cartoon preview and visual feedback for AI agents",
  "version": "0.1.0",
  "publisher": "zimba-local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:zimba.open",
    "onCustomEditor:zimba.project"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Zimba runs trusted scene code to produce cartoons."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zimba.open",
        "title": "Zimba: Open Studio"
      }
    ],
    "customEditors": [
      {
        "viewType": "zimba.project",
        "displayName": "Zimba Studio",
        "selector": [
          {
            "filenamePattern": "**/project.json"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "zimba.open",
          "when": "resourceFilename == project.json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.0",
    "gsap": "^3.13.0",
    "konva": "^10.0.0",
    "lucide": "^0.468.0",
    "playwright": "^1.51.0",
    "zimba": "file:..",
    "zod": "^3.25.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
